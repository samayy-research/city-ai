OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Default: no project database or browser storage; refresh resets the conversation.
PROJECT_STORAGE_MODE=demo
# Optional: set PROJECT_STORAGE_MODE=persistent to save projects.
# Persistent mode uses SQLite locally and requires Redis on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace may instead provide KV_REST_API_URL / KV_REST_API_TOKEN.
# Both naming conventions are supported; configure one complete matching pair.

# Optional coordination-email draft preparation.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CITY_COORDINATION_EMAIL=
